# Blog Medicinal — variáveis de ambiente
# Copie para .env (VPS) ou .env.local (desenvolvimento). Nunca versione o arquivo preenchido.

# ─── Obrigatórias ────────────────────────────────────────────

# Supabase do blog (projeto blog_medicinalnaweb). Use a chave pública (anon/publishable):
# ela só lê conteúdo publicado, por causa do RLS.
SUPABASE_URL="https://hsixbybpwvhvkwxeaxup.supabase.co"
SUPABASE_ANON_KEY=""

# URL pública do blog (usada em sitemap, canonical e Open Graph)
NEXT_PUBLIC_SITE_URL="https://blog.medicinalnaweb.com.br"

# ─── Opcionais ───────────────────────────────────────────────

# Segredo para POST /api/revalidate (limpar o cache logo após publicar)
REVALIDATE_SECRET=""

# Só para o formulário de newsletter gravar inscritos (server-side, nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=""
